Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Compatibilitate cu variantele de nume solicitate; standardele folosesc lowercase
  RewriteRule ^LLMS\.txt$ /llms.txt [R=301,L]
  RewriteRule ^ROBOTS\.TXT$ /robots.txt [R=301,L]
  RewriteRule ^Sitemap\.xml$ /sitemap.xml [R=301,L]

  # HTTPS pentru domeniul canonic
  RewriteCond %{HTTP_HOST} ^www\.psiholognicoletaamihaesi\.ro$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://psiholognicoletaamihaesi.ro%{REQUEST_URI} [R=301,L]

  # Domeniul alternativ indicat redirecționează la domeniul canonic
  RewriteCond %{HTTP_HOST} ^(www\.)?psihoterapeutnicoletaamihaesi\.ro$ [NC]
  RewriteRule ^ https://psiholognicoletaamihaesi.ro%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
